<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>aura_s7</name>
  <version>1.0.0</version>

  <description>
    ROS2-based trajectory tracking controller for UR5 robot integrating MATLAB-generated optimal trajectories 
    with real-time execution, feedback synchronization, and performance evaluation (Project AURA – Sprint 7).
  </description>

  <maintainer email="seth.nihal.work@gmail.com">Nihal Sanjay Seth</maintainer>

  <license>MIT</license>

  <!-- Core Dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Python dependency -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>